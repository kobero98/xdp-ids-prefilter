# config.env — testbed-specific settings, the ONLY file to edit on a new machine.
#
# Sourced by the shell scripts (scripts/env.sh) and parsed by the Python
# orchestrator (eval/settings.py). Plain KEY=VALUE lines, no shell expansion.
# Any variable already set in the environment overrides the value below.

# ── Device under test (DUT, runs Suricata + XDP filter) ──────────────────────
DUT_IFACE=ens11np1            # data NIC: XDP program attached here, test traffic
DUT_DATA_IP=10.0.1.1/24
DUT_MGMT_IFACE=ens9np0        # management NIC: master<->slave control socket
DUT_MGMT_IP=10.0.2.1/24
DUT_RX_RING=8192              # ethtool -G rx (paper: 8192)

# ── Traffic generator (slave) ─────────────────────────────────────────────────
SLAVE_MGMT_IP=10.0.2.2        # slave.py listens here
SLAVE_PORT=9090
SLAVE_DPDK_PCI=09:00.0        # PCI address of the slave data NIC (pcap_replay -a)
SLAVE_IFACE=enp9s0np1         # slave data NIC name (tcpreplay --intf1)
SLAVE_PCAP_DIR=datasets/pcap  # directory holding the replayed pcaps on the slave
SLAVE_PCAP_REPLAY=eval/traffic/build/pcap_replay

# ── Software paths on the DUT ────────────────────────────────────────────────
SURICATA_BIN=/usr/local/bin/suricata
# hscollider from the linux-regex-module build (only for the Hyperscan kfunc module)
HSCOLLIDER=kernel/hs_kfunc/linux-regex-module/build/bin/hscollider
# Where datasets (pcaps, rulesets) are stored; see datasets/README.md
DATA_DIR=datasets
# Where generated artefacts (filtered rules, patterns, .acdb) are written
BUILD_DIR=build
